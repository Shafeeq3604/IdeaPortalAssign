# IEP — copy to .env. The process REFUSES TO START on a missing/malformed value (SPEC §4.4).

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://iep:iep@localhost:5433/iep
REDIS_URL=redis://localhost:6380

# ── API only ──
PORT=3001
PUBLIC_WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-at-least-32-characters-long
OIDC_ISSUER=https://example-idp.invalid
OIDC_CLIENT_ID=dev-client-id
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
ATTACHMENT_STORAGE_DIR=./.storage

# ── Self-registration (FR-01a) ──
# On by default. The control that matters is the domain list, not this switch.
SIGNUP_ENABLED=true

# Comma-separated email domains allowed to register themselves, e.g. sageitinc.com.
# EMPTY MEANS ANY DOMAIN CAN REGISTER. On anything reachable from the internet that means
# anyone with the URL can read every submitted idea. SET THIS BEFORE YOU DEPLOY.
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# First-run administrator bootstrap. Presenting this code at signup grants ADMIN, but ONLY
# while the database has no active administrator at all — the moment one exists the code
# stops working for good. Leave it unset if you seeded an admin; every administrator after
# the first is promoted by an existing one, on the audit trail.
# ADMIN_INVITE_CODE=at-least-sixteen-characters


# ── WORKER only ──
# The Anthropic key does NOT belong in this file. It lives in apps/worker/.env,
# because the API process refuses to boot if it can see one (SPEC §4.4).
# See apps/worker/.env.example.
