# IEP — copy to .env. The process REFUSES TO START on a missing/malformed value (SPEC §4.4).

NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://iep:iep@localhost:5432/iep
REDIS_URL=redis://localhost:6379

# ── API only ──
PORT=3001
PUBLIC_WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-at-least-32-characters-long
OIDC_ISSUER=https://example-idp.invalid
OIDC_CLIENT_ID=dev-client-id
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
ATTACHMENT_STORAGE_DIR=./.storage

# ── WORKER only. Never set ANTHROPIC_API_KEY on the API process — boot fails (SPEC §4.4).
ANTHROPIC_API_KEY=
AI_PROVIDER=stub
AI_BUDGET_PER_VERSION_USD=0.75
AI_BUDGET_ORG_DAILY_USD=200
AI_BUDGET_USER_DAILY_USD=5
AI_RAW_PAYLOAD_RETENTION_DAYS=90
PII_REDACTION_ENABLED=true
