# IEP — copy to .env. The process REFUSES TO START on a missing/malformed value (SPEC §4.4).

NODE_ENV=development
LOG_LEVEL=info
# `connection_limit` is explicit, not left to Prisma's `num_cpus * 2 + 1` default — that
# formula gives 5 connections on a 2-core box and 9 on a typical dev laptop, which is fine
# serially but starves under real concurrent traffic. The k6 load test (SPEC §11.6) found
# this the hard way: 200 concurrent users queued for a connection pool of 5-9 and p95 blew
# past the 400ms budget (1.3s on a 2-core CI runner) despite every request succeeding and
# the database itself being nowhere near its own max_connections. Tune the number to your
# actual deployment's DB capacity — this is a starting point, not a universal answer.
DATABASE_URL=postgresql://iep:iep@localhost:5433/iep?connection_limit=20&pool_timeout=20
REDIS_URL=redis://localhost:6380

# ── API only ──
PORT=3001
PUBLIC_WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-at-least-32-characters-long
OIDC_ISSUER=https://example-idp.invalid
OIDC_CLIENT_ID=dev-client-id
OIDC_CLIENT_SECRET=dev-client-secret
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# Where attachment bytes live. `local` is a real production limitation, not just a dev
# default: a restart loses whatever wasn't on a mounted volume, and it breaks outright the
# moment there is more than one API instance, since each has its own disk. Switch to
# `azure-blob` before either of those is true of a deployment.
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_STORAGE_DIR=./.storage
# Only read when ATTACHMENT_STORAGE_PROVIDER=azure-blob — uncomment and fill in both:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=attachments

# ── Self-registration (FR-01a) ──
# On by default. The control that matters is the domain list, not this switch.
SIGNUP_ENABLED=true

# Comma-separated email domains allowed to register themselves, e.g. sageitinc.com.
# EMPTY MEANS ANY DOMAIN CAN REGISTER. On anything reachable from the internet that means
# anyone with the URL can read every submitted idea. SET THIS BEFORE YOU DEPLOY.
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# First-run administrator bootstrap. Presenting this code at signup grants ADMIN, but ONLY
# while the database has no active administrator at all — the moment one exists the code
# stops working for good. Leave it unset if you seeded an admin; every administrator after
# the first is promoted by an existing one, on the audit trail.
# ADMIN_INVITE_CODE=at-least-sixteen-characters


# ── WORKER only ──
# The Anthropic key does NOT belong in this file. It lives in apps/worker/.env,
# because the API process refuses to boot if it can see one (SPEC §4.4).
# See apps/worker/.env.example.
