# apps/worker/.env.example — copy to apps/worker/.env
#
# WORKER ONLY. The Anthropic key lives here and nowhere else: only the worker may
# reach the model provider, and the API refuses to start if it can see one (SPEC §4.4).

ANTHROPIC_API_KEY=
AI_PROVIDER=stub   # switch to "anthropic" for real analysis (~$0.23/idea)
AI_BUDGET_PER_VERSION_USD=0.75
AI_BUDGET_ORG_DAILY_USD=200
AI_BUDGET_USER_DAILY_USD=5
AI_RAW_PAYLOAD_RETENTION_DAYS=90
PII_REDACTION_ENABLED=true

# iManner LLM observability — OPTIONAL. Off unless every field below is set (see
# apps/worker/src/observability.ts). Reports every real Anthropic call this worker makes
# (analysis pipeline steps + the Discovery Agent), attributed by agent/user/idea, to the
# iManner dashboard. Leave OBS_ENABLED=false (or all four fields blank) to disable.
OBS_ENABLED=false
# OBS_API_ENDPOINT=https://<your-imanner-ingestion-host>
# OBS_API_KEY=
OBS_APPLICATION_ID=idea-portal
OBS_APPLICATION_NAME=IEP — Idea Portal
# local | development | staging | production — set per deployment, NOT per code change.
OBS_ENVIRONMENT=local
OBS_SAMPLING_RATE=1.0
