# apps/worker/.env.example — copy to apps/worker/.env
#
# WORKER ONLY. The Anthropic key lives here and nowhere else: only the worker may
# reach the model provider, and the API refuses to start if it can see one (SPEC §4.4).

ANTHROPIC_API_KEY=
AI_PROVIDER=stub   # switch to "anthropic" for real analysis (~$0.23/idea)
AI_BUDGET_PER_VERSION_USD=0.75
AI_BUDGET_ORG_DAILY_USD=200
AI_BUDGET_USER_DAILY_USD=5
AI_RAW_PAYLOAD_RETENTION_DAYS=90
PII_REDACTION_ENABLED=true
