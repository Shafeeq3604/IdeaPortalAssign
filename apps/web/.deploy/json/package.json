{
  "name": "iep",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:bdd": "node scripts/assert-suites-exist.mjs test:bdd tests/bdd && turbo run test:bdd",
    "test:e2e": "node scripts/assert-suites-exist.mjs test:e2e tests/e2e && turbo run test:e2e",
    "test:nav": "vitest run --config vitest.arch.config.ts",
    "test:arch": "vitest run --config vitest.arch.config.ts",
    "lint": "turbo run lint",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @iep/db migrate",
    "db:seed": "pnpm --filter @iep/db seed",
    "eval": "turbo run eval",
    "lighthouse": "turbo run lighthouse",
    "smoke": "node scripts/smoke.mjs",
    "deploy:prune": "node scripts/prepare-deploy.mjs",
    "preflight": "node scripts/preflight-docker.mjs",
    "deps:up": "docker compose -f docker-compose.deps.yml up -d",
    "deps:down": "docker compose -f docker-compose.deps.yml down",
    "openapi:generate": "tsx scripts/generate-openapi.mts",
    "openapi:check": "tsx scripts/generate-openapi.mts && git diff --exit-code --stat -- openapi.json",
    "demo:data": "tsx --env-file-if-exists=.env scripts/demo-data.mts",
    "demo:clean": "tsx --env-file-if-exists=.env scripts/demo-clean.mts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo-data.mts --fresh && pnpm db:seed && tsx --env-file-if-exists=.env scripts/demo-data.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2",
    "@iep/db": "workspace:*",
    "@iep/ai": "workspace:*",
    "@iep/evaluation": "workspace:*",
    "@iep/worker": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
