{
  "name": "@iep/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"lint: configured in P9\""
  },
  "dependencies": {
    "@iep/ai": "workspace:*",
    "@iep/contracts": "workspace:*",
    "@iep/db": "workspace:*",
    "@iep/scoring": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^6.0.0",
    "@iep/evaluation": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
