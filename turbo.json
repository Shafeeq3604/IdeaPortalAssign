{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    /* Turbo 2's default strict env mode only lets a task's process see environment
       variables declared here — everything else, including a value set by the CI job
       itself, is silently stripped before the task's process starts. Without this,
       apps/api's real-database integration test falls back to its own hardcoded local
       default (postgresql://iep:iep@localhost:5433/iep) instead of whatever the caller
       actually set, which is invisible until the two happen to disagree. */
    "test": { "dependsOn": ["^build"], "env": ["DATABASE_URL"] },
    "test:watch": { "cache": false, "persistent": true },
    /* Same strict-env trap as "test" above: F-01's spec hardcodes the same local-port
       fallback, so this looked fine locally by coincidence and would silently hit the
       wrong port the moment CI's Postgres isn't on 5433. */
    "test:bdd": { "dependsOn": ["^build"], "env": ["DATABASE_URL"] },
    "test:e2e": { "dependsOn": ["^build"], "cache": false, "env": ["CI", "E2E_BASE_URL"] },
    "lint": {},
    "eval": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
