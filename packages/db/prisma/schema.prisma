// IEP — Prisma schema.  FROZEN AT P0 (SPEC §5, §14).
// Additive changes follow SPEC §14.1. Breaking changes: STOP and ask.
//
// Constraints marked [SPEC] are load-bearing: they encode a requirement, not a preference.
// They are applied by migration SQL (see migrations/) because Prisma cannot express CHECK.
// Every one has a test in packages/db/test/constraints.test.ts — an untested constraint
// is an unenforced requirement.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────── ENUMS (mirror @iep/contracts) ───────────────────────────

enum Role {
  EMPLOYEE
  REVIEWER
  ADMIN
  MANAGEMENT
}

enum IdeaStatus {
  DRAFT
  SUBMITTED
  AI_ANALYSIS
  NEEDS_CLARIFICATION
  EVALUATED
  RANKED
  UNDER_REVIEW
  PROTOTYPE_CANDIDATE
  PILOT
  PRODUCTION_CANDIDATE
  IMPLEMENTED
  PARKED
  BLOCKED
  REJECTED
  ARCHIVED
}

enum AnalysisStep {
  STRUCTURE
  USE_CASES
  VALUE
  FEASIBILITY
  RISK
  EFFORT_TIMELINE
  IMPROVEMENT
  EXPLANATION
}
enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}
enum Band {
  NEGLIGIBLE
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}
enum Confidence {
  LOW
  MEDIUM
  HIGH
}
enum ScoreSource {
  AI
  HUMAN
  SIGNAL
  FALLBACK
}
enum UseCaseKind {
  DIRECT
  INDIRECT
}
enum Horizon {
  SHORT
  MEDIUM
  LONG
}
enum UserCountBand {
  LT10
  B10_100
  B100_1K
  B1K_10K
  GT10K
}
enum FeasibilityStatus {
  HIGHLY_FEASIBLE
  FEASIBLE_WITH_CONDITIONS
  REQUIRES_INVESTIGATION
  NOT_CURRENTLY_FEASIBLE
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum EffortClass {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}
enum TimelinePhase {
  DISCOVERY
  PROTOTYPE
  MVP
  TESTING
  DEPLOYMENT
}
enum RequirementKind {
  PEOPLE
  TECHNOLOGY
  DATA
  ORG
}
enum DependencyKind {
  INTERNAL
  EXTERNAL
  VENDOR
  DATA
}
enum CriterionGroup {
  VALUE
  FEASIBILITY
  EFFORT
  STRATEGIC
  RISK
  DEMAND
}
enum CriterionDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}
enum CriterionSourceKind {
  AI_FACTOR
  SIGNAL
  HUMAN
}
enum ExplanationSource {
  ENGINE
  ENGINE_PLUS_AI_NARRATIVE
}
enum RankingEffect {
  LIKELY_UP
  POSSIBLY_UP
  NEUTRAL
  UNKNOWN
}
enum RecommendationState {
  OPEN
  ADDRESSED
  DISMISSED
}
enum ReviewDecision {
  VALIDATED
  NEEDS_CLARIFICATION
  OVERRIDDEN
  APPROVED_FOR_PROTOTYPE
  REJECTED
  PARKED
}
enum ModelTier {
  A
  B
  C
}
enum ThinkingMode {
  ADAPTIVE
  BUDGETED
  NONE
}

enum ValueDimension {
  BUSINESS_IMPACT
  PRODUCTIVITY
  COST_REDUCTION
  REVENUE
  EMPLOYEE_EXPERIENCE
  CUSTOMER_IMPACT
  OPERATIONAL
  PROBLEM_SEVERITY
  PROBLEM_FREQUENCY
}

enum FeasibilityDimension {
  TECHNICAL
  DATA
  INFRASTRUCTURE
  INTEGRATION
  SECURITY
  PRIVACY
  COMPLIANCE
  EXPERTISE
  RESOURCES
  COST
  EXTERNAL_DEPENDENCY
}

enum RiskCategory {
  TECHNICAL
  SECURITY
  PRIVACY
  COMPLIANCE
  FINANCIAL
  OPERATIONAL
  ADOPTION
  DATA
  VENDOR
}

// ─────────────────────────────── IDENTITY ───────────────────────────────

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  parentId  String?      @map("parent_id") @db.Uuid
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DeptTree")
  users     User[]
  ideas     Idea[]
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("departments")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  externalSubject String     @unique @map("external_subject")
  email           String     @unique
  displayName     String     @map("display_name")
  departmentId    String?    @map("department_id") @db.Uuid
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  isActive        Boolean    @default(true) @map("is_active")

  /// Argon2id (ADR-023). Null for an account that has never been given a password —
  /// an SSO-only user, or one an admin created but has not set one for yet.
  /// NEVER selected into a response; `AdminUser` has no field it could populate.
  passwordHash    String?    @map("password_hash")
  passwordSetAt   DateTime?  @map("password_set_at") @db.Timestamptz(3)
  /// Consecutive failures since the last success. Drives lockout (NFR-01).
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)

  roles                UserRole[]
  ideas                Idea[]                       @relation("Submitter")
  authoredVersions     IdeaVersion[]                @relation("VersionAuthor")
  uploads              Attachment[]
  reviews              Review[]
  overrides            ScoreOverride[]
  statusChanges        StatusHistory[]
  auditEntries         AuditLog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// ─────────────────────────────── IDEA ───────────────────────────────

model IdeaCategory {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  ideas     Idea[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("idea_categories")
}

model Idea {
  id            String        @id @default(uuid()) @db.Uuid
  submitterId   String        @map("submitter_id") @db.Uuid
  submitter     User          @relation("Submitter", fields: [submitterId], references: [id], onDelete: Restrict)
  departmentId  String?       @map("department_id") @db.Uuid
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  categoryId    String?       @map("category_id") @db.Uuid
  category      IdeaCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status        IdeaStatus    @default(DRAFT)
  maturityLevel Int?          @map("maturity_level") // 1..5, derived — SPEC §5.3
  currentVersionId String?    @unique @map("current_version_id") @db.Uuid
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz(3)

  versions      IdeaVersion[]  @relation("IdeaVersions")
  currentVersion IdeaVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  reviews       Review[]
  statusHistory StatusHistory[]
  rankingEntries RankingEntry[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, departmentId])
  @@index([submitterId, createdAt(sort: Desc)])
  @@map("ideas")
}

model IdeaVersion {
  id            String @id @default(uuid()) @db.Uuid
  ideaId        String @map("idea_id") @db.Uuid
  idea          Idea   @relation("IdeaVersions", fields: [ideaId], references: [id], onDelete: Cascade)
  versionNo     Int    @map("version_no")

  // Required (SPEC §9.2 / FR-02)
  title            String
  description      String
  problemStatement String @map("problem_statement")
  expectedUsers    String @map("expected_users")
  expectedOutcome  String @map("expected_outcome")

  // Optional
  existingProcess    String? @map("existing_process")
  existingSolutions  String? @map("existing_solutions")
  suggestedTechnology String? @map("suggested_technology")
  expectedBenefits   String? @map("expected_benefits")
  estimatedCostNote  String? @map("estimated_cost_note")
  references         String?

  changeSummary String? @map("change_summary") // null on v1 only — [SPEC] CHECK
  authorId      String  @map("author_id") @db.Uuid
  author        User    @relation("VersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  contentHash   String  @map("content_hash")

  /// RESERVED at P0 for M2 duplicate detection (ADR-012). Unpopulated in M1.
  embedding Unsupported("vector(1536)")? @map("embedding")

  attachments   Attachment[]
  analyses      AiAnalysis[]
  feasibility   FeasibilityAssessment?
  risks         Risk[]
  dependencies  Dependency[]
  plan          ImplementationPlan?
  evaluations   Evaluation[]
  recommendations ImprovementRecommendation[] @relation("RecommendationVersion")
  resolvedRecommendations ImprovementRecommendation[] @relation("ResolvedInVersion")
  currentOf     Idea? @relation("CurrentVersion")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ideaId, versionNo])
  @@index([contentHash])
  @@map("idea_versions")
}

model Attachment {
  id            String      @id @default(uuid()) @db.Uuid
  ideaVersionId String      @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  filename      String
  mime          String
  bytes         Int
  storageKey    String      @map("storage_key")
  uploadedById  String      @map("uploaded_by") @db.Uuid
  uploadedBy    User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("attachments")
}

// ───────────────────── AI OUTPUT (the ONLY place model output lands) ─────────────────────

model AiAnalysis {
  id            String         @id @default(uuid()) @db.Uuid
  ideaVersionId String         @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion    @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  step          AnalysisStep
  status        AnalysisStatus @default(PENDING)

  provider        String
  model           String
  tier            ModelTier
  promptVersion   String   @map("prompt_version")
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  cachedInputTokens Int?   @map("cached_input_tokens")
  costUsdMicros   Int?     @map("cost_usd_micros")
  redactionApplied Boolean @default(false) @map("redaction_applied")
  escalatedFromTier ModelTier? @map("escalated_from_tier")
  rawPayload      Json?    @map("raw_payload") // 90-day retention (SPEC §4.5)
  errorCode       String?  @map("error_code")
  startedAt       DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(3)

  proposal     AiStructuredProposal?
  useCases     UseCase[]
  valueFindings ValueFinding[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ideaVersionId, step])
  @@map("ai_analyses")
}

model AiStructuredProposal {
  id           String     @id @default(uuid()) @db.Uuid
  aiAnalysisId String     @unique @map("ai_analysis_id") @db.Uuid
  aiAnalysis   AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)

  problemStatement       String   @map("problem_statement")
  proposedSolution       String   @map("proposed_solution")
  targetUsers            String   @map("target_users")
  assumptions            String[]
  missingInformation     String[] @map("missing_information")
  clarificationQuestions String[] @map("clarification_questions")

  @@map("ai_structured_proposals")
}

model UseCase {
  id           String        @id @default(uuid()) @db.Uuid
  aiAnalysisId String        @map("ai_analysis_id") @db.Uuid
  aiAnalysis   AiAnalysis    @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  kind         UseCaseKind
  horizon      Horizon
  title        String
  description  String
  departmentScope String[]   @map("department_scope")
  estimatedUserCountBand UserCountBand @map("estimated_user_count_band")
  isSpeculative Boolean      @default(false) @map("is_speculative")

  @@map("use_cases")
}

model ValueFinding {
  id           String         @id @default(uuid()) @db.Uuid
  aiAnalysisId String         @map("ai_analysis_id") @db.Uuid
  aiAnalysis   AiAnalysis     @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  dimension    ValueDimension
  band         Band
  rationale    String
  evidence     String[] // [SPEC] CHECK cardinality > 0 — P-7

  @@unique([aiAnalysisId, dimension])
  @@map("value_findings")
}

// ───────────────────────────── FEASIBILITY ─────────────────────────────

model FeasibilityAssessment {
  id            String            @id @default(uuid()) @db.Uuid
  ideaVersionId String            @unique @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion       @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  status        FeasibilityStatus
  summary       String
  /// [SPEC] CHECK: status = NOT_CURRENTLY_FEASIBLE requires cardinality > 0 — FR-06
  constraintCitations String[]    @map("constraint_citations")

  findings FeasibilityFinding[]

  @@map("feasibility_assessments")
}

model FeasibilityFinding {
  id           String               @id @default(uuid()) @db.Uuid
  assessmentId String               @map("assessment_id") @db.Uuid
  assessment   FeasibilityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimension    FeasibilityDimension
  band         Band
  finding      String
  condition    String? // what would make it feasible

  @@unique([assessmentId, dimension])
  @@map("feasibility_findings")
}

// ───────────────────────── RISK & IMPLEMENTATION ─────────────────────────

model Risk {
  id              String       @id @default(uuid()) @db.Uuid
  ideaVersionId   String       @map("idea_version_id") @db.Uuid
  ideaVersion     IdeaVersion  @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  category        RiskCategory
  description     String
  level           RiskLevel
  potentialImpact String       @map("potential_impact")
  mitigation      String // [SPEC] NOT NULL — FR-10 requires a mitigation for every risk

  @@map("risks")
}

model Dependency {
  id            String         @id @default(uuid()) @db.Uuid
  ideaVersionId String         @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion    @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  kind          DependencyKind
  description   String
  blocking      Boolean        @default(false)

  @@map("dependencies")
}

model ImplementationPlan {
  id            String      @id @default(uuid()) @db.Uuid
  ideaVersionId String      @unique @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  effortClass   EffortClass @map("effort_class")
  costClass     EffortClass @map("cost_class")
  operationalComplexity EffortClass @map("operational_complexity")
  notes         String?

  requirements ImplementationRequirement[]
  timeline     TimelineEstimate[]

  @@map("implementation_plans")
}

model ImplementationRequirement {
  id          String             @id @default(uuid()) @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  plan        ImplementationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind        RequirementKind
  item        String
  detail      String?
  isMandatory Boolean            @default(true) @map("is_mandatory")

  @@map("implementation_requirements")
}

model TimelineEstimate {
  id       String             @id @default(uuid()) @db.Uuid
  planId   String             @map("plan_id") @db.Uuid
  plan     ImplementationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase    TimelinePhase
  minWeeks Int                @map("min_weeks")
  maxWeeks Int                @map("max_weeks")
  /// [SPEC] CHECK (is_preliminary) — FR-08. A non-preliminary AI estimate is unstorable.
  isPreliminary Boolean       @default(true) @map("is_preliminary")

  @@unique([planId, phase])
  @@map("timeline_estimates")
}

// ─────────────────────────── EVALUATION CONFIG ───────────────────────────

model EvaluationCriterion {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique
  label       String
  description String
  group       CriterionGroup
  direction   CriterionDirection
  scaleMin    Int                 @default(0) @map("scale_min")
  scaleMax    Int                 @default(100) @map("scale_max")
  sourceKind  CriterionSourceKind @map("source_kind")
  isActive    Boolean             @default(true) @map("is_active")

  weights ProfileWeight[]
  scores  CriterionScore[]
  recommendations ImprovementRecommendation[]

  @@map("evaluation_criteria")
}

model EvaluationProfile {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String
  isDefault   Boolean @default(false) @map("is_default")
  isActive    Boolean @default(true) @map("is_active")

  weights     ProfileWeight[]
  evaluations Evaluation[]
  rankingRuns RankingRun[]

  @@map("evaluation_profiles")
}

model ProfileWeight {
  profileId   String              @map("profile_id") @db.Uuid
  profile     EvaluationProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  criterionId String              @map("criterion_id") @db.Uuid
  criterion   EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  /// [SPEC] deferred constraint trigger: active profile weights SUM = 1.0000 ±0.0001
  weight      Decimal             @db.Decimal(5, 4)

  @@id([profileId, criterionId])
  @@map("profile_weights")
}

/// Model routing is CONFIGURATION, not code (ADR-021, SPEC §12.1.2).
model AiModelRoute {
  storyKey     String       @id @map("story_key")
  tier         ModelTier
  modelId      String       @map("model_id")
  effort       String?
  thinkingMode ThinkingMode @map("thinking_mode")
  thinkingBudgetTokens Int? @map("thinking_budget_tokens")
  maxTokens    Int          @map("max_tokens")
  enabled      Boolean      @default(true)
  updatedById  String?      @map("updated_by") @db.Uuid
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_model_routes")
}

// ─────────────────────────── EVALUATION RESULTS ───────────────────────────

model Evaluation {
  id             String            @id @default(uuid()) @db.Uuid
  ideaVersionId  String            @map("idea_version_id") @db.Uuid
  ideaVersion    IdeaVersion       @relation(fields: [ideaVersionId], references: [id], onDelete: Cascade)
  profileId      String            @map("profile_id") @db.Uuid
  profile        EvaluationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  engineVersion  String            @map("engine_version")
  compositeScore Decimal           @map("composite_score") @db.Decimal(6, 3)
  maturityLevel  Int               @map("maturity_level")
  computedAt     DateTime          @default(now()) @map("computed_at") @db.Timestamptz(3)

  criterionScores CriterionScore[]
  rankingEntries  RankingEntry[]

  @@unique([ideaVersionId, profileId, engineVersion])
  @@map("evaluations")
}

model CriterionScore {
  id           String              @id @default(uuid()) @db.Uuid
  evaluationId String              @map("evaluation_id") @db.Uuid
  evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionId  String              @map("criterion_id") @db.Uuid
  criterion    EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  rawBand      Band?        @map("raw_band")
  normalized   Decimal      @db.Decimal(6, 3)
  weight       Decimal      @db.Decimal(5, 4)
  contribution Decimal      @db.Decimal(6, 3)
  source       ScoreSource
  confidence   Confidence
  rationale    String
  evidence     String[] // [SPEC] CHECK cardinality > 0 — P-7

  overrides ScoreOverride[]

  @@unique([evaluationId, criterionId])
  @@map("criterion_scores")
}

model ScoreOverride {
  id                 String         @id @default(uuid()) @db.Uuid
  criterionScoreId   String         @map("criterion_score_id") @db.Uuid
  criterionScore     CriterionScore @relation(fields: [criterionScoreId], references: [id], onDelete: Cascade)
  reviewerId         String         @map("reviewer_id") @db.Uuid
  reviewer           User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  previousNormalized Decimal        @map("previous_normalized") @db.Decimal(6, 3)
  newNormalized      Decimal        @map("new_normalized") @db.Decimal(6, 3)
  reason             String // [SPEC] NOT NULL — FR-22
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("score_overrides")
}

// ─────────────────────────── RANKING (immutable snapshots, ADR-008) ───────────────────────────

model RankingRun {
  id            String            @id @default(uuid()) @db.Uuid
  profileId     String            @map("profile_id") @db.Uuid
  profile       EvaluationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  cohortKey     Json              @map("cohort_key")
  engineVersion String            @map("engine_version")
  triggeredById String?           @map("triggered_by") @db.Uuid
  triggerReason String            @map("trigger_reason")
  computedAt    DateTime          @default(now()) @map("computed_at") @db.Timestamptz(3)

  entries RankingEntry[]

  @@index([profileId, computedAt(sort: Desc)])
  @@map("ranking_runs")
}

model RankingEntry {
  id             String     @id @default(uuid()) @db.Uuid
  runId          String     @map("run_id") @db.Uuid
  run            RankingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ideaId         String     @map("idea_id") @db.Uuid
  idea           Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  evaluationId   String     @map("evaluation_id") @db.Uuid
  evaluation     Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  rank           Int
  compositeScore Decimal    @map("composite_score") @db.Decimal(6, 3)
  percentile     Decimal    @db.Decimal(5, 2)
  previousRank   Int?       @map("previous_rank")

  explanation RankingExplanation?

  @@unique([runId, ideaId])
  @@unique([runId, rank])
  @@map("ranking_entries")
}

model RankingExplanation {
  id          String            @id @default(uuid()) @db.Uuid
  entryId     String            @unique @map("entry_id") @db.Uuid
  entry       RankingEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  /// [SPEC] all three CHECK jsonb_array_length > 0 for strengths/constraints — P-2
  strengths       Json
  constraints     Json
  peerComparisons Json          @map("peer_comparisons")
  generatedBy     ExplanationSource @map("generated_by")

  @@map("ranking_explanations")
}

// ─────────────────────────── IMPROVEMENT ───────────────────────────

model ImprovementRecommendation {
  id            String      @id @default(uuid()) @db.Uuid
  ideaVersionId String      @map("idea_version_id") @db.Uuid
  ideaVersion   IdeaVersion @relation("RecommendationVersion", fields: [ideaVersionId], references: [id], onDelete: Cascade)

  // All six NOT NULL — FR-15's structure cannot be partially satisfied
  issue                  String
  whyItMatters           String        @map("why_it_matters")
  recommendation         String
  howToImplement         String        @map("how_to_implement")
  expectedEffect         String        @map("expected_effect")
  projectedRankingEffect RankingEffect @map("projected_ranking_effect")

  targetCriterionId String?              @map("target_criterion_id") @db.Uuid
  targetCriterion   EvaluationCriterion? @relation(fields: [targetCriterionId], references: [id], onDelete: SetNull)
  priority          Int // 1..3 — [SPEC] CHECK BETWEEN 1 AND 3
  status            RecommendationState  @default(OPEN)
  resolvedInVersionId String?            @map("resolved_in_version_id") @db.Uuid
  resolvedInVersion   IdeaVersion?       @relation("ResolvedInVersion", fields: [resolvedInVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("improvement_recommendations")
}

// ─────────────────────────── GOVERNANCE ───────────────────────────

model Review {
  id         String         @id @default(uuid()) @db.Uuid
  ideaId     String         @map("idea_id") @db.Uuid
  idea       Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  reviewerId String         @map("reviewer_id") @db.Uuid
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision   ReviewDecision
  /// [SPEC] CHECK: decision = REJECTED requires comment IS NOT NULL — FR-23
  comment    String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ideaId, createdAt(sort: Desc)])
  @@map("reviews")
}

model StatusHistory {
  id         String     @id @default(uuid()) @db.Uuid
  ideaId     String     @map("idea_id") @db.Uuid
  idea       Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fromStatus IdeaStatus? @map("from_status")
  toStatus   IdeaStatus @map("to_status")
  actorId    String     @map("actor_id") @db.Uuid
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason     String?
  at         DateTime   @default(now()) @db.Timestamptz(3)

  @@index([ideaId, at(sort: Desc)])
  @@map("status_history")
}

/// APPEND-ONLY. The application DB role has no UPDATE/DELETE grant (SPEC §4.7).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  requestId  String?  @map("request_id")
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@map("audit_log")
}

// ══════════════════════════════════════════════════════════════════════════
// RESERVED AT P0 — created empty, unpopulated in M1 (ADR-012, SPEC §5.1).
// Present so M2/M3 are additive rather than a migration against a frozen schema.
// ══════════════════════════════════════════════════════════════════════════

enum FeedbackType {
  WOULD_USE
  HAVE_PROBLEM
  SIMILAR_USE_CASE
  CAN_PROVIDE_DATA
  CAN_HELP_IMPLEMENT
  SEE_RISK
  HAVE_IMPROVEMENT
}

model Feedback {
  id        String       @id @default(uuid()) @db.Uuid
  ideaId    String       @map("idea_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      FeedbackType
  comment   String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ideaId, userId, type])
  @@map("feedback")
}

model DemandSignal {
  id          String   @id @default(uuid()) @db.Uuid
  ideaId      String   @map("idea_id") @db.Uuid
  signalKey   String   @map("signal_key")
  value       Decimal  @db.Decimal(10, 3)
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@unique([ideaId, signalKey])
  @@map("demand_signals")
}

model SimilarIdea {
  id         String  @id @default(uuid()) @db.Uuid
  ideaId     String  @map("idea_id") @db.Uuid
  similarTo  String  @map("similar_to") @db.Uuid
  similarity Decimal @db.Decimal(5, 4)
  differenceSummary String? @map("difference_summary")

  @@unique([ideaId, similarTo])
  @@map("similar_ideas")
}

/// The curated capability catalogue. PRIMARY source for FR-21 (SPEC §12.3 AI-11).
/// MCP retrieval is optional enrichment, never a dependency.
model ExistingSolution {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  kind        String // INTERNAL_SYSTEM | APPROVED_VENDOR | PLATFORM_CAPABILITY
  description String
  ownerDepartmentId String? @map("owner_department_id") @db.Uuid
  categories  String[]
  isActive    Boolean  @default(true) @map("is_active")
  embedding   Unsupported("vector(1536)")?

  @@map("existing_solutions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  event     String
  entityId  String?   @map("entity_id") @db.Uuid
  payload   Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model KpiDefinition {
  id          String @id @default(uuid()) @db.Uuid
  ideaId      String @map("idea_id") @db.Uuid
  name        String
  unit        String
  targetValue Decimal? @map("target_value") @db.Decimal(14, 3)
  predictedValue Decimal? @map("predicted_value") @db.Decimal(14, 3)

  measurements KpiMeasurement[]

  @@map("kpi_definitions")
}

model KpiMeasurement {
  id           String        @id @default(uuid()) @db.Uuid
  definitionId String        @map("definition_id") @db.Uuid
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  actualValue  Decimal       @map("actual_value") @db.Decimal(14, 3)
  measuredAt   DateTime      @map("measured_at") @db.Timestamptz(3)

  @@map("kpi_measurements")
}

model PilotRecord {
  id        String    @id @default(uuid()) @db.Uuid
  ideaId    String    @unique @map("idea_id") @db.Uuid
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  outcome   String?

  @@map("pilot_records")
}
